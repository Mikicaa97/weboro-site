# Copy to .env.local for local development — never commit real secrets.
# Contact form (Vercel serverless: /api/contact)

# Required for delivery
RESEND_API_KEY=
CONTACT_TO_EMAIL=kontakt@weboro.io
CONTACT_FROM_EMAIL=Weboro Website <noreply@weboro.io>

# Optional
CONTACT_SUBJECT_PREFIX=[Weboro upit]

# DEV ONLY — allow Resend onboarding sender when CONTACT_FROM_EMAIL is unset.
# Never set this in Vercel Production.
# CONTACT_ALLOW_DEV_SENDER=1

# Optional: override API path (default /api/contact)
# VITE_CONTACT_API_URL=/api/contact
